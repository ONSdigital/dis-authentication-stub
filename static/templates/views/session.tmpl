{{ define "content" }}
<p>Your session is active and expires at {{ .User.Expiry }}</p>
<button id="refreshButton" onclick="refreshSession()" class="ons-btn ons-u-mb-l ons-u-mt-xl">
    <span class="ons-btn__inner">
        <span class="ons-btn__text">Refresh Session</span>
    </span>
</button>

<button class="ons-btn ons-btn--secondary ons-u-mb-l ons-u-mt-xl" type="submit" onclick="deleteSession();">
    <span class="ons-btn__inner">
        <span class="ons-btn__text">Delete Session</span>
    </span>
</button>

<script>
    function deleteSession() {
        fetch('/api/v1/tokens/self', {
            method: 'DELETE'
        }).then(response => {
            if (response.ok) {
                alert('Session deleted successfully!');
                window.location.reload();
            } else {
                alert('Failed to delete session.');
            }
        });
    }

    // Function to refresh the session tokens
    function refreshSession() {
        fetch('/api/v1/tokens/self', {
            method: 'PUT'
        }).then(response => {
            if (response.ok) {
                alert('Session refreshed successfully!');
                window.location.reload();
            } else {
                alert('Failed to refresh session.');
            }
        });
    }
</script>

{{ end }}
